modules = ["nodejs-24", "python-3.12", "postgresql-16"]

[deployment]
router = "application"
deploymentTarget = "vm"
ignorePorts = false

[deployment.postBuild]
args = ["pnpm", "store", "prune"]
env = { "CI" = "true" }

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "streamline-tests"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "streamline-gateway"

[[workflows.workflow]]
name = "streamline-tests"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "cd artifacts/api-server/python && env -u STREAMBOT_TEST_POSTGRES python3 -m unittest discover -s tests -v"

[workflows.workflow.metadata]
isValidation = true

[[workflows.workflow]]
name = "streamline-gateway"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "node --check artifacts/streamline/gateway.mjs && bash -n artifacts/api-server/start-python.sh scripts/restore-demo-state.sh scripts/post-merge.sh && git diff --check"

[workflows.workflow.metadata]
isValidation = true

[agent]
stack = "PNPM_WORKSPACE"
expertMode = true

[postMerge]
path = "scripts/post-merge.sh"
timeoutMs = 20000

[userenv]

[userenv.production]
STREAMBOT_DATABASE_SOURCE = "managed"
STREAMBOT_LIVE_PAYMENTS_ENABLED = "true"
STREAMBOT_MODE = "live"
STREAMBOT_PANEL_WRITE_ENABLED = "true"
STREAMBOT_PUBLIC_URL = "https://flexandflix.com"
STREAMBOT_TELEGRAM_ENABLED = "true"

[userenv.shared]

[nix]
channel = "stable-25_05"
packages = ["cargo", "libiconv", "libxcrypt", "openssl", "pkg-config", "postgresql", "rustc"]

[[ports]]
localPort = 5000
externalPort = 80
